menuconfig BUILD_AMBARELLA_GST_PLUGIN
  bool "Build Ambarella GStreamer Plugin"
  default n
  help
    Build Ambarella GStreamer Plugin

if BUILD_AMBARELLA_GST_PLUGIN

choice
  bool "Choose Way of Building Amba GST Pulgin"

config CHOICE_YOCTO_BUILD_AMBA_GST
  bool "YOCTO Build for Amba GST Pulgin"
  select CONFIG_GLIB_2__DOT__0
  select CONFIG_GSTREAMER1__DOT__0
  select CONFIG_GSTREAMER1__DOT__0_LIBAV
  select CONFIG_GSTREAMER1__DOT__0_META_BASE
  select CONFIG_GSTREAMER1__DOT__0_PLUGINS_BASE
  select CONFIG_GSTREAMER1__DOT__0_PLUGINS_GOOD
  select CONFIG_GSTREAMER1__DOT__0_PLUGINS_BAD
  select CONFIG_GSTREAMER1__DOT__0_PLUGINS_UGLY
  select CONFIG_GSTREAMER1__DOT__0_RTSP_SERVER
  select CONFIG_JSON_GLIB
  select CONFIG_JSON_C
  select CONFIG_LIBRSVG
  select CONFIG_ALSA_LIB
  select CONFIG_PULSEAUDIO
  select CONFIG_AMBARELLA_AAC_ENC_FULL_SUPPORT
  select CONFIG_AMBARELLA_AAC_DEC_FULL_SUPPORT
  select CONFIG_LIBPNG
  select CONFIG_LIBJPEG_TURBO
  select CONFIG_FREETYPE
  select CONFIG_ZIP
  select CONFIG_BZIP2
  help
    YOCTO Build for Amba GST Plugin

config CHOICE_AMBA_BUILD_AMBA_GST
  bool "Amba Build for Amba GST Plugin"
  select CONFIG_PREBUILD_GLIB2
  select CONFIG_PREBUILD_GSTREAMER1
  select CONFIG_PREBUILD_GSTREAMER1_PLUGIN_LIBAV
  select CONFIG_PREBUILD_GSTREAMER1_PLUGINS_BASE
  select CONFIG_PREBUILD_GSTREAMER1_PLUGINS_GOOD
  select CONFIG_PREBUILD_GSTREAMER1_PLUGINS_BAD
  select CONFIG_PREBUILD_GSTREAMER1_PLUGINS_UGLY
  select CONFIG_PREBUILD_GSTREAMER1_RTSP_SERVER
  select CONFIG_PREBUILD_GSTREAMER1_PLUGIN_OPENH264
  select CONFIG_PREBUILD_JSON_GLIB
  select CONFIG_PREBUILD_JSON_C
  select CONFIG_PREBUILD_ALSA_LIB
  select CONFIG_PREBUILD_PULSEAUDIO
  select CONFIG_AMBARELLA_AAC_ENC_FULL_SUPPORT
  select CONFIG_AMBARELLA_AAC_DEC_FULL_SUPPORT
  select CONFIG_PREBUILD_LIBPNG
  select CONFIG_PREBUILD_LIBJPEG_TURBO
  select CONFIG_PREBUILD_FREETYPE
  select CONFIG_PREBUILD_BZIP2
  help
    Amba Build for Amba GST Pulgin

endchoice

endif
